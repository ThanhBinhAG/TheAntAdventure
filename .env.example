# =============================================================================
# The Ant Adventures CRM v4.3 — Environment variables
# =============================================================================
#
# SETUP:
#   1. Copy this file to `.env.local` in the project root:
#        cp .env.example .env.local        (Mac/Linux)
#        copy .env.example .env.local      (Windows)
#   2. Fill in Supabase URL + anon key (and optional service role) below.
#   3. Restart the dev server after editing: npm run dev
#
# App data: company self-host Supabase — set URL/keys in `.env.local` only.
# Never commit real keys; use server env / CI secrets for deploy.
#
# SECURITY:
#   - Never commit `.env.local` (already in .gitignore).
#   - NEXT_PUBLIC_* vars are exposed to the browser — use the anon key only.
#   - Keep SUPABASE_SERVICE_ROLE_KEY server-side only.
#
# =============================================================================

# --- Redis (server-side only) ---
# Production runs against VM06 shared Redis on the `shared-services` Docker network.
# CI injects the password from the Redis Docker secret; set a local URL for development.
# CI_REQUIRED
REDIS_URL=redis://:YOUR_REDIS_PASSWORD@shared_redis:6379/1
# Assigned automatically in CI; must match the `/1` portion of REDIS_URL.
# CI_REQUIRED
REDIS_DB=1
REDIS_CONNECT_TIMEOUT_MS=1000
# Production (VM06): CI sets password + DB on shared_redis, e.g.
#   REDIS_URL=redis://:YOUR_REDIS_PASSWORD@shared_redis:6379/1
# Assigned automatically in CI; must match the `/N` portion of REDIS_URL.
# REDIS_DB=1

# --- Supabase (required when USE_SUPABASE=true) ---
# Self-host example URL — replace with your instance; keys from Supabase Studio / ops.
# CI_REQUIRED
NEXT_PUBLIC_SUPABASE_URL=https://sb.example.com:9001
# CI_REQUIRED
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional — allow insecure TLS to self-hosted Supabase (server-side only).
# Also auto-enabled for sb.mitelai.com via lib/supabase/tls-config.ts when URL matches.
# SUPABASE_TLS_INSECURE=true

# Required for restricted server-side operations (do NOT expose in client code)
# CI_REQUIRED
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase CLI migrations (orthogonal to app API URL — never commit passwords) ---
# Remote self-hosted: postgresql://postgres:YOUR_PASSWORD@HOST:5432/postgres
# Use npm run db:push (primary). Optional db:push:local is schema dry-run only.
# CI_REQUIRED
SUPABASE_DB_URL=

# Supabase Cloud only — from Dashboard → Project Settings → General → Reference ID
# Self-hosted Studio may use `default` as shown in Terminal Instructions
SUPABASE_PROJECT_REF=

# Supabase Cloud only — from https://supabase.com/dashboard/account/tokens
# Not required when using SUPABASE_DB_URL on self-hosted instances
SUPABASE_ACCESS_TOKEN=

# Weather weekly forecast — server cron + manual refresh API
# Generate a long random string; used by scripts/cron-refresh-weather.sh
# CI_REQUIRED
WEATHER_CRON_SECRET=

# --- Data layer (required) ---
# CRM data is stored in Supabase only — no localStorage cache for business data.
# Set true and fill URL + anon key above (accepts true/TRUE/1/yes)
# CI_REQUIRED
NEXT_PUBLIC_USE_SUPABASE=true

# Auto push app edits → Supabase (default: on when USE_SUPABASE=true)
# Set false to disable and use manual "Push full snapshot" only
NEXT_PUBLIC_SUPABASE_AUTO_SYNC=true

# Read-only Supabase — hydrate only, no push (recommended on shared company DB while developing)
NEXT_PUBLIC_SUPABASE_READ_ONLY=true

# --- Authentication (required — local và production đều phải đăng nhập) ---
# Cloudflare Turnstile site key (optional — leave empty to skip CAPTCHA on login)
# Configure secret key in Supabase Dashboard → Auth → Bot and Abuse Protection
NEXT_PUBLIC_AUTH_CAPTCHA_SITE_KEY=

# Break-glass account (server-only — optional recovery admin; NOT an email)
# Leave empty to disable. Never commit real values. Not exposed to the browser.
# CI_REQUIRED
# BREAK_GLASS_USERNAME=
# CI_REQUIRED
# BREAK_GLASS_PASSWORD=

# --- System debug (server-only — tắt sau khi troubleshoot xong) ---
# Bật trang /system/debug và API diagnostics cho admin server
# Token gửi qua header X-Debug-Token (không dùng ?token= query)
SYSTEM_DEBUG=false
SYSTEM_DEBUG_TOKEN=change-me-to-long-random-string

# --- App metadata ---
NEXT_PUBLIC_APP_NAME="The Ant Adventures CRM"
NEXT_PUBLIC_APP_VERSION="4.3"

# Base URL for server-side PDF asset links / cron (dev: localhost; demo: company URL)
APP_URL=http://localhost:3006
# Optional — custom Chrome/Chromium binary for proposal PDF export
# PUPPETEER_EXECUTABLE_PATH=

# WSL/Linux — if Download PDF fails with libnspr4 / "Failed to launch the browser process":
#   bash scripts/setup-pdf-deps-wsl.sh
# Then restart: npm run dev
# Alternative: use Print / Save PDF in Tour Design Step 5 (browser print dialog).
